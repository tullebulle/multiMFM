#!/bin/bash
#SBATCH --job-name=glass_grad_metrics
#SBATCH --partition=kempner_h100
#SBATCH -A kempner_albergo_lab
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=3:00:00
#SBATCH --output=slurm/logs/slurm-%x-%j.out
#SBATCH --error=slurm/logs/slurm-%x-%j.err

set -euo pipefail
cd "${SLURM_SUBMIT_DIR}"
mkdir -p slurm/logs
export PYTHONPATH="${SLURM_SUBMIT_DIR}:${PYTHONPATH:-}"

PYTHON="${PYTHON:-/n/home04/uunneberg/micromamba/envs/seq_h100/bin/python}"
RUN_DIR="${RUN_DIR:-workdir/rebuttal_gradient_accuracy_gc}"

"${PYTHON}" -u scripts/add_gradient_accuracy_metrics.py --run_dir "${RUN_DIR}" --device cuda:0
